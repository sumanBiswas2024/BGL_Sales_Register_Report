<mvc:View
    controllerName="com.bgl.app.salesregister.controller.SalesRegister"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:svm="sap.ui.comp.smartvariants"
>
    <f:DynamicPage
        id="pageId"
        headerExpanded="true"
        preserveHeaderStateOnScroll="true"
    >
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <svm:SmartVariantManagement
                        id="svm"
                        showExecuteOnSelection="true"
                    />
                </f:heading>
                <f:expandedContent>
                    <Label
                        id="expandedLabel"
                        text="No filters active"
                    />
                </f:expandedContent>
                <f:snappedContent>
                    <Label
                        id="snappedLabel"
                        text="No filters active"
                    />
                </f:snappedContent>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader>
                <f:content>
                    <fb:FilterBar
                        id="filterbar"
                        persistencyKey="salesKey"
                        search=".onSearch"
                        useToolbar="false"
                    >
                        <fb:filterGroupItems>
                            <fb:FilterGroupItem
                                name="fromDate"
                                label="From Date"
                                groupName="Group1"
                                visibleInFilterBar="true"
                            >
                                <fb:control>
                                    <DatePicker
                                        id="idFromDate"
                                        valueFormat="yyyy-MM-dd"
                                        displayFormat="dd/MM/yyyy"
                                        required="true"
                                        change=".onDateChange"
                                    />
                                </fb:control>
                            </fb:FilterGroupItem>
                            <fb:FilterGroupItem
                                name="toDate"
                                label="To Date"
                                groupName="Group1"
                                visibleInFilterBar="true"
                            >
                                <fb:control>
                                    <DatePicker
                                        id="idToDate"
                                        valueFormat="yyyy-MM-dd"
                                        displayFormat="dd/MM/yyyy"
                                        required="true"
                                        change=".onDateChange"
                                    />
                                </fb:control>
                            </fb:FilterGroupItem>
                            <fb:FilterGroupItem
                                name="division"
                                label="Division"
                                groupName="Group1"
                                visibleInFilterBar="true"
                            >
                                <fb:control>
                                    <Input
                                        id="idDivision"
                                        showValueHelp="true"
                                        valueHelpRequest=".onDivisionValueHelp"
                                        required="true"
                                    />
                                </fb:control>
                            </fb:FilterGroupItem>
                        </fb:filterGroupItems>
                    </fb:FilterBar>
                </f:content>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <VBox>
                <OverflowToolbar>
                    <!-- Show data row count only (exclude grand total row) -->
                    <Title
                        text="{= ${TableDataModel>/results}.length > 0 ? 'Items (' + (${TableDataModel>/results}.length - 1) + ')' : 'Items (0)'}"
                    />
                    <ToolbarSpacer />
                    <Button
                        icon="sap-icon://sort"
                        tooltip="Sort"
                        press=".onSortButtonPressed"
                        visible="false"
                    />
                    <Button
                        icon="sap-icon://excel-attachment"
                        press="onExport"
                        tooltip="Export to Excel"
                    />
                </OverflowToolbar>

                <ScrollContainer
                    width="100%"
                    horizontal="true"
                    vertical="true"
                >
                    <Table
                        id="idSalesTable"
                        items="{TableDataModel>/results}"
                        sticky="ColumnHeaders"
                        fixedLayout="false"
                        class="tableWrapper"
                        growing="true"
                        growingThreshold="500"
                        growingScrollToLoad="false"
                        updateStarted=".onTableUpdateStarted"
                        updateFinished=".onTableUpdateFinished"
                    >
                        <columns>
                            <Column width="35rem">
                                <Text
                                    text="Invoice Date"
                                    wrapping="false"
                                />
                            </Column>
                            <Column width="35rem">
                                <Text
                                    text="Invoice Month"
                                    wrapping="false"
                                />
                            </Column>
                            <Column width="35rem">
                                <Text
                                    text="Fiscal Year"
                                    wrapping="false"
                                />
                            </Column>
                            <Column width="35rem">
                                <Text
                                    text="Invoice No"
                                    wrapping="false"
                                />
                            </Column>
                            <Column width="35rem">
                                <Text
                                    text="Sold To Code"
                                    wrapping="false"
                                />
                            </Column>
                            <Column width="35rem">
                                <Text
                                    text="Sold To Name"
                                    wrapping="false"
                                />
                            </Column>
                            <Column width="35rem">
                                <Text
                                    text="Sale Type"
                                    wrapping="false"
                                />
                            </Column>
                            <Column width="35rem">
                                <Text
                                    text="Billing Doc Status"
                                    wrapping="false"
                                />
                            </Column>
                            <Column width="35rem">
                                <Text
                                    text="Sales District (Charge Area)"
                                    wrapping="false"
                                />
                            </Column>
                            <Column width="35rem">
                                <Text
                                    text="Acct Assmt Grp / Sales Group"
                                    wrapping="false"
                                />
                            </Column>
                            <Column width="35rem">
                                <Text
                                    text="Customer Type"
                                    wrapping="false"
                                />
                            </Column>
                            <Column width="35rem">
                                <Text
                                    text="Item"
                                    wrapping="false"
                                />
                            </Column>
                            <Column width="35rem">
                                <Text
                                    text="Profit Centre"
                                    wrapping="false"
                                />
                            </Column>
                            <Column width="35rem">
                                <Text
                                    text="Ship To Code"
                                    wrapping="false"
                                />
                            </Column>
                            <Column width="35rem">
                                <Text
                                    text="Ship To Name"
                                    wrapping="false"
                                />
                            </Column>
                            <Column width="35rem">
                                <Text
                                    text="GA of BGL"
                                    wrapping="false"
                                />
                            </Column>
                            <Column width="35rem">
                                <Text
                                    text="Material Code"
                                    wrapping="false"
                                />
                            </Column>
                            <Column width="35rem">
                                <Text
                                    text="Material Name"
                                    wrapping="false"
                                />
                            </Column>
                            <Column width="35rem">
                                <Text
                                    text="Billing Qty"
                                    wrapping="false"
                                />
                            </Column>
                            <Column width="35rem">
                                <Text
                                    text="Billing UOM"
                                    wrapping="false"
                                />
                            </Column>
                            <Column width="35rem">
                                <Text
                                    text="Price to Update"
                                    wrapping="false"
                                />
                            </Column>
                            <Column width="35rem">
                                <Text
                                    text="Trade Margin"
                                    wrapping="false"
                                />
                            </Column>
                            <Column width="35rem">
                                <Text
                                    text="Discount Excl."
                                    wrapping="false"
                                />
                            </Column>
                            <Column width="35rem">
                                <Text
                                    text="Excise Duty ST"
                                    wrapping="false"
                                />
                            </Column>
                            <Column width="35rem">
                                <Text
                                    text="Taxable Value (Rs.)"
                                    wrapping="false"
                                />
                            </Column>
                            <Column width="35rem">
                                <Text
                                    text="ED Recovery"
                                    wrapping="false"
                                />
                            </Column>
                            <Column width="35rem">
                                <Text
                                    text="Excise Duty"
                                    wrapping="false"
                                />
                            </Column>
                            <Column width="35rem">
                                <Text
                                    text="Net Taxable Value (Rs.)"
                                    wrapping="false"
                                />
                            </Column>
                            <Column width="35rem">
                                <Text
                                    text="VAT Tax Rate %"
                                    wrapping="false"
                                />
                            </Column>
                            <Column width="35rem">
                                <Text
                                    text="VAT Tax (Rs.)"
                                    wrapping="false"
                                />
                            </Column>
                            <Column width="35rem">
                                <Text
                                    text="IGST"
                                    wrapping="false"
                                />
                            </Column>
                            <Column width="35rem">
                                <Text
                                    text="IGST %"
                                    wrapping="false"
                                />
                            </Column>
                            <Column width="35rem">
                                <Text
                                    text="CGST"
                                    wrapping="false"
                                />
                            </Column>
                            <Column width="35rem">
                                <Text
                                    text="CGST %"
                                    wrapping="false"
                                />
                            </Column>
                            <Column width="35rem">
                                <Text
                                    text="SGST"
                                    wrapping="false"
                                />
                            </Column>
                            <Column width="35rem">
                                <Text
                                    text="SGST %"
                                    wrapping="false"
                                />
                            </Column>
                            <Column width="35rem">
                                <Text
                                    text="TCS"
                                    wrapping="false"
                                />
                            </Column>
                            <Column width="35rem">
                                <Text
                                    text="TCS %"
                                    wrapping="false"
                                />
                            </Column>
                            <Column width="35rem">
                                <Text
                                    text="Invoice Value (Rs.)"
                                    wrapping="false"
                                />
                            </Column>
                            <Column width="35rem">
                                <Text
                                    text="Class"
                                    wrapping="false"
                                />
                            </Column>
                            <Column width="35rem">
                                <Text
                                    text="Distribution Channel"
                                    wrapping="false"
                                />
                            </Column>
                            <Column width="35rem">
                                <Text
                                    text="Daily Authorized Qty"
                                    wrapping="false"
                                />
                            </Column>
                            <Column width="35rem">
                                <Text
                                    text="Daily Authorized Qty (UOM)"
                                    wrapping="false"
                                />
                            </Column>
                        </columns>

                        <items>
                            <ColumnListItem
                                highlight="{= ${TableDataModel>IsGrandTotal} ? 'Success' : 'None'}"
                                type="Inactive"
                            >
                                <cells>
                                    <!-- Col 1: date for data rows, "Grand Total" label for total row -->
                                    <Text
                                        text="{parts: [{path: 'TableDataModel>BillingDocumentDate'}, {path: 'TableDataModel>IsGrandTotal'}], formatter: '.formatInvoiceDate'}"
                                        wrapping="false"
                                    />
                                    <Text
                                        text="{TableDataModel>InvoiceMonthName}"
                                        wrapping="false"
                                    />
                                    <Text
                                        text="{TableDataModel>FiscalYear}"
                                        wrapping="false"
                                    />
                                    <Text
                                        text="{TableDataModel>BillingDocument}"
                                        wrapping="false"
                                    />
                                    <Text
                                        text="{TableDataModel>SoldToParty}"
                                        wrapping="false"
                                    />
                                    <Text
                                        text="{TableDataModel>SoldToName}"
                                        wrapping="false"
                                    />
                                    <Text
                                        text="{TableDataModel>BillingDocumentTypeText}"
                                        wrapping="false"
                                    />
                                    <Text
                                        text="{TableDataModel>OverallBillingStatus}"
                                        wrapping="false"
                                    />
                                    <Text
                                        text="{TableDataModel>SalesDistrictName}"
                                        wrapping="false"
                                    />
                                    <Text
                                        text="{TableDataModel>SalesGroupName}"
                                        wrapping="false"
                                    />
                                    <Text
                                        text="{TableDataModel>CustomerGroupName}"
                                        wrapping="false"
                                    />
                                    <Text
                                        text="{TableDataModel>BillingDocumentItem}"
                                        wrapping="false"
                                    />
                                    <Text
                                        text="{TableDataModel>ProfitCenter}"
                                        wrapping="false"
                                    />
                                    <Text
                                        text="{TableDataModel>ShipToParty}"
                                        wrapping="false"
                                    />
                                    <Text
                                        text="{TableDataModel>ShipToName}"
                                        wrapping="false"
                                    />
                                    <Text
                                        text="{TableDataModel>Plant}"
                                        wrapping="false"
                                    />
                                    <Text
                                        text="{TableDataModel>Material}"
                                        wrapping="false"
                                    />
                                    <Text
                                        text="{TableDataModel>BillingDocumentItemText}"
                                        wrapping="false"
                                    />
                                    <Text
                                        text="{path: 'TableDataModel>BillingQuantity', type: 'sap.ui.model.type.Float', formatOptions: {minFractionDigits: 3, maxFractionDigits: 3, groupingEnabled: true}}"
                                        wrapping="false"
                                    />
                                    <Text
                                        text="{TableDataModel>BillingQuantityUnit}"
                                        wrapping="false"
                                    />
                                    <Text
                                        text="{path: 'TableDataModel>PriceToUpdate',   type: 'sap.ui.model.type.Float', formatOptions: {minFractionDigits: 2, maxFractionDigits: 2, groupingEnabled: true}}"
                                        wrapping="false"
                                    />
                                    <Text
                                        text="{path: 'TableDataModel>TradeMargin',     type: 'sap.ui.model.type.Float', formatOptions: {minFractionDigits: 2, maxFractionDigits: 2, groupingEnabled: true}}"
                                        wrapping="false"
                                    />
                                    <Text
                                        text="{path: 'TableDataModel>DiscountExcl',    type: 'sap.ui.model.type.Float', formatOptions: {minFractionDigits: 2, maxFractionDigits: 2, groupingEnabled: true}}"
                                        wrapping="false"
                                    />
                                    <Text
                                        text="{path: 'TableDataModel>ExciseDutySt',    type: 'sap.ui.model.type.Float', formatOptions: {minFractionDigits: 2, maxFractionDigits: 2, groupingEnabled: true}}"
                                        wrapping="false"
                                    />
                                    <Text
                                        text="{path: 'TableDataModel>TaxableValue',    type: 'sap.ui.model.type.Float', formatOptions: {minFractionDigits: 2, maxFractionDigits: 2, groupingEnabled: true}}"
                                        wrapping="false"
                                    />
                                    <Text
                                        text="{path: 'TableDataModel>EdRecovery',      type: 'sap.ui.model.type.Float', formatOptions: {minFractionDigits: 2, maxFractionDigits: 2, groupingEnabled: true}}"
                                        wrapping="false"
                                    />
                                    <Text
                                        text="{path: 'TableDataModel>ExciseDuty',      type: 'sap.ui.model.type.Float', formatOptions: {minFractionDigits: 2, maxFractionDigits: 2, groupingEnabled: true}}"
                                        wrapping="false"
                                    />
                                    <Text
                                        text="{path: 'TableDataModel>NetTaxableValue', type: 'sap.ui.model.type.Float', formatOptions: {minFractionDigits: 2, maxFractionDigits: 2, groupingEnabled: true}}"
                                        wrapping="false"
                                    />
                                    <Text
                                        text="{path: 'TableDataModel>TaxRatePer',      type: 'sap.ui.model.type.Float', formatOptions: {minFractionDigits: 2, maxFractionDigits: 2, groupingEnabled: false}}"
                                        wrapping="false"
                                    />
                                    <Text
                                        text="{path: 'TableDataModel>TaxVatRs',        type: 'sap.ui.model.type.Float', formatOptions: {minFractionDigits: 2, maxFractionDigits: 2, groupingEnabled: true}}"
                                        wrapping="false"
                                    />
                                    <Text
                                        text="{path: 'TableDataModel>Igst',            type: 'sap.ui.model.type.Float', formatOptions: {minFractionDigits: 2, maxFractionDigits: 2, groupingEnabled: true}}"
                                        wrapping="false"
                                    />
                                    <Text
                                        text="{path: 'TableDataModel>IgstPer',         type: 'sap.ui.model.type.Float', formatOptions: {minFractionDigits: 2, maxFractionDigits: 2, groupingEnabled: false}}"
                                        wrapping="false"
                                    />
                                    <Text
                                        text="{path: 'TableDataModel>Cgst',            type: 'sap.ui.model.type.Float', formatOptions: {minFractionDigits: 2, maxFractionDigits: 2, groupingEnabled: true}}"
                                        wrapping="false"
                                    />
                                    <Text
                                        text="{path: 'TableDataModel>CgstPer',         type: 'sap.ui.model.type.Float', formatOptions: {minFractionDigits: 2, maxFractionDigits: 2, groupingEnabled: false}}"
                                        wrapping="false"
                                    />
                                    <Text
                                        text="{path: 'TableDataModel>Sgst',            type: 'sap.ui.model.type.Float', formatOptions: {minFractionDigits: 2, maxFractionDigits: 2, groupingEnabled: true}}"
                                        wrapping="false"
                                    />
                                    <Text
                                        text="{path: 'TableDataModel>SgstPer',         type: 'sap.ui.model.type.Float', formatOptions: {minFractionDigits: 2, maxFractionDigits: 2, groupingEnabled: false}}"
                                        wrapping="false"
                                    />
                                    <Text
                                        text="{path: 'TableDataModel>Tcs',             type: 'sap.ui.model.type.Float', formatOptions: {minFractionDigits: 2, maxFractionDigits: 2, groupingEnabled: true}}"
                                        wrapping="false"
                                    />
                                    <Text
                                        text="{path: 'TableDataModel>TcsPer',          type: 'sap.ui.model.type.Float', formatOptions: {minFractionDigits: 2, maxFractionDigits: 2, groupingEnabled: false}}"
                                        wrapping="false"
                                    />
                                    <Text
                                        text="{path: 'TableDataModel>InvoiceValue',    type: 'sap.ui.model.type.Float', formatOptions: {minFractionDigits: 2, maxFractionDigits: 2, groupingEnabled: true}}"
                                        wrapping="false"
                                    />
                                    <Text
                                        text="{TableDataModel>class}"
                                        wrapping="false"
                                    />
                                    <Text
                                        text="{TableDataModel>SalesOrderDistributionChannel}"
                                        wrapping="false"
                                    />
                                    <Text
                                        text="{path: 'TableDataModel>DailyAuthQty',    type: 'sap.ui.model.type.Float', formatOptions: {minFractionDigits: 3, maxFractionDigits: 3, groupingEnabled: true}}"
                                        wrapping="false"
                                    />
                                    <Text
                                        text="{TableDataModel>DailyAuthUnit}"
                                        wrapping="false"
                                    />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </ScrollContainer>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
