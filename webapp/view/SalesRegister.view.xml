<mvc:View
    controllerName="com.bgl.app.salesregister.controller.SalesRegister"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:fb="sap.ui.comp.filterbar"
>
    <f:DynamicPage
        id="pageId"
        headerExpanded="true"
    >
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="Sales Register Report" />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader>
                <f:content>
                    <fb:FilterBar
                        id="filterbar"
                        persistencyKey="salesKey"
                        useToolbar="false"
                        search=".onSearch"
                    >
                        <fb:filterGroupItems>
                            <fb:FilterGroupItem
                                name="fromDate"
                                label="From Date"
                                groupName="Group1"
                                visibleInFilterBar="true"
                            >
                                <fb:control>
                                    <DatePicker
                                        id="idFromDate"
                                        valueFormat="yyyy-MM-dd"
                                        displayFormat="dd/MM/yyyy"
                                        required="true"
                                    />
                                </fb:control>
                            </fb:FilterGroupItem>

                            <fb:FilterGroupItem
                                name="toDate"
                                label="To Date"
                                groupName="Group1"
                                visibleInFilterBar="true"
                            >
                                <fb:control>
                                    <DatePicker
                                        id="idToDate"
                                        valueFormat="yyyy-MM-dd"
                                        displayFormat="dd/MM/yyyy"
                                        required="true"
                                    />
                                </fb:control>
                            </fb:FilterGroupItem>

                            <fb:FilterGroupItem
                                name="division"
                                label="Division"
                                groupName="Group1"
                                visibleInFilterBar="true"
                            >
                                <fb:control>
                                    <Input
                                        id="idDivision"
                                        showValueHelp="true"
                                        valueHelpRequest=".onDivisionValueHelp"
                                        required="true"
                                    />
                                </fb:control>
                            </fb:FilterGroupItem>
                        </fb:filterGroupItems>
                    </fb:FilterBar>
                </f:content>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <VBox>
                <OverflowToolbar>
                    <Title
                        text="Items ({= ${TableDataModel>/results}.length || 0})"
                    />
                    <ToolbarSpacer />
                    <Button
                        icon="sap-icon://excel-attachment"
                        press="onExport"
                        tooltip="Export to Excel"
                    />
                </OverflowToolbar>

                <ScrollContainer
                    width="100%"
                    horizontal="true"
                    vertical="true"
                >
                    <Table
                        id="idSalesTable"
                        items="{TableDataModel>/results}"
                        sticky="ColumnHeaders"
                        fixedLayout="false"
                        class="tableWrapper"
                    >
                        <columns>
                            <!-- ── Core / Green columns ──────────────────────── -->
                            <Column width="9rem">
                                <Text text="Invoice Date" />
                            </Column>
                            <Column width="8rem">
                                <Text text="Invoice Month" />
                            </Column>
                            <Column width="6rem">
                                <Text text="Fiscal Year" />
                            </Column>
                            <Column width="9rem">
                                <Text text="Invoice No" />
                            </Column>
                            <Column width="8rem">
                                <Text text="Sold To Code" />
                            </Column>
                            <Column width="12rem">
                                <Text text="Sold To Name" />
                            </Column>
                            <Column width="10rem">
                                <Text text="Sale Type" />
                            </Column>
                            <Column width="10rem">
                                <Text text="Billing Doc Status" />
                            </Column>
                            <Column width="12rem">
                                <Text text="Sales District (Charge Area)" />
                            </Column>
                            <Column width="12rem">
                                <Text text="Acct Assmt Grp / Sales Group" />
                            </Column>
                            <Column width="10rem">
                                <Text text="Customer Type" />
                            </Column>
                            <Column width="5rem">
                                <Text text="Item" />
                            </Column>
                            <Column width="8rem">
                                <Text text="Profit Centre" />
                            </Column>
                            <Column width="8rem">
                                <Text text="Ship To Code" />
                            </Column>
                            <Column width="12rem">
                                <Text text="Ship To Name" />
                            </Column>
                            <Column width="8rem">
                                <Text text="GA of BGL" />
                            </Column>
                            <Column width="10rem">
                                <Text text="Material Code" />
                            </Column>
                            <Column width="14rem">
                                <Text text="Material Name" />
                            </Column>
                            <Column
                                width="8rem"
                                hAlign="End"
                            >
                                <Text text="Billing Qty" />
                            </Column>
                            <Column width="5rem">
                                <Text text="Billing UOM" />
                            </Column>

                            <!-- ── Pricing / Yellow columns ──────────────────── -->
                            <Column
                                width="9rem"
                                hAlign="End"
                            >
                                <Text text="Price to Update" />
                            </Column>
                            <Column
                                width="9rem"
                                hAlign="End"
                            >
                                <Text text="Trade Margin" />
                            </Column>
                            <Column
                                width="9rem"
                                hAlign="End"
                            >
                                <Text text="Discount Excl." />
                            </Column>
                            <Column
                                width="9rem"
                                hAlign="End"
                            >
                                <Text text="Excise Duty ST" />
                            </Column>
                            <Column
                                width="10rem"
                                hAlign="End"
                            >
                                <Text text="Taxable Value (Rs.)" />
                            </Column>
                            <Column
                                width="9rem"
                                hAlign="End"
                            >
                                <Text text="ED Recovery" />
                            </Column>
                            <Column
                                width="9rem"
                                hAlign="End"
                            >
                                <Text text="Excise Duty" />
                            </Column>
                            <Column
                                width="11rem"
                                hAlign="End"
                            >
                                <Text text="Net Taxable Value (Rs.)" />
                            </Column>
                            <Column
                                width="7rem"
                                hAlign="End"
                            >
                                <Text text="VAT Rate %" />
                            </Column>
                            <Column
                                width="9rem"
                                hAlign="End"
                            >
                                <Text text="VAT Tax (Rs.)" />
                            </Column>
                            <Column
                                width="8rem"
                                hAlign="End"
                            >
                                <Text text="IGST" />
                            </Column>
                            <Column
                                width="6rem"
                                hAlign="End"
                            >
                                <Text text="IGST %" />
                            </Column>
                            <Column
                                width="8rem"
                                hAlign="End"
                            >
                                <Text text="CGST" />
                            </Column>
                            <Column
                                width="6rem"
                                hAlign="End"
                            >
                                <Text text="CGST %" />
                            </Column>
                            <Column
                                width="8rem"
                                hAlign="End"
                            >
                                <Text text="SGST" />
                            </Column>
                            <Column
                                width="6rem"
                                hAlign="End"
                            >
                                <Text text="SGST %" />
                            </Column>
                            <Column
                                width="8rem"
                                hAlign="End"
                            >
                                <Text text="TCS" />
                            </Column>
                            <Column
                                width="6rem"
                                hAlign="End"
                            >
                                <Text text="TCS %" />
                            </Column>

                            <!-- ── Summary / Green columns ───────────────────── -->
                            <Column
                                width="11rem"
                                hAlign="End"
                            >
                                <Text text="Invoice Value (Rs.)" />
                            </Column>
                            <Column width="8rem">
                                <Text text="Class" />
                            </Column>
                            <Column width="10rem">
                                <Text text="Dist. Channel" />
                            </Column>
                            <Column
                                width="9rem"
                                hAlign="End"
                            >
                                <Text text="Daily Auth Qty" />
                            </Column>
                            <Column width="6rem">
                                <Text text="Auth UOM" />
                            </Column>
                        </columns>

                        <items>
                            <ColumnListItem
                                highlight="{= ${TableDataModel>IsGrandTotal} ? 'Success' : 'None'}"
                                type="Inactive"
                            >
                                <cells>
                                    <!-- ── Core / Green columns ──────────────────────── -->
                                    <Text
                                        text="{path: 'TableDataModel>BillingDocumentDate', type: 'sap.ui.model.type.Date', formatOptions: {pattern: 'dd/MM/yyyy'}}"
                                    />
                                    <Text
                                        text="{TableDataModel>InvoiceMonthName}"
                                    />
                                    <Text text="{TableDataModel>FiscalYear}" />
                                    <Text
                                        text="{TableDataModel>BillingDocument}"
                                        class="{= ${TableDataModel>IsGrandTotal} ? 'sapUiStrongBold' : ''}"
                                    />
                                    <Text text="{TableDataModel>SoldToParty}" />
                                    <Text text="{TableDataModel>SoldToName}" />
                                    <Text
                                        text="{TableDataModel>BillingDocumentTypeText}"
                                    />
                                    <Text
                                        text="{TableDataModel>OverallBillingStatus}"
                                    />
                                    <Text
                                        text="{TableDataModel>SalesDistrictName}"
                                    />
                                    <!-- FIX: was SalesGroupName; should reflect CustomerAccountAssignmentGroup / SalesGroupName per backend -->
                                    <Text
                                        text="{TableDataModel>SalesGroupName}"
                                    />
                                    <!-- FIX: was CustomerGroupName (correct for CustomerClassification lookup) -->
                                    <Text
                                        text="{TableDataModel>CustomerGroupName}"
                                    />
                                    <Text
                                        text="{TableDataModel>BillingDocumentItem}"
                                    />
                                    <Text
                                        text="{TableDataModel>ProfitCenter}"
                                    />
                                    <Text text="{TableDataModel>ShipToParty}" />
                                    <Text text="{TableDataModel>ShipToName}" />
                                    <Text text="{TableDataModel>Plant}" />
                                    <Text text="{TableDataModel>Material}" />
                                    <Text
                                        text="{TableDataModel>BillingDocumentItemText}"
                                    />
                                    <Text
                                        text="{TableDataModel>BillingQuantity}"
                                    />
                                    <Text
                                        text="{TableDataModel>BillingQuantityUnit}"
                                    />

                                    <!-- ── Pricing / Yellow columns ──────────────────── -->
                                    <Text
                                        text="{TableDataModel>PriceToUpdate}"
                                    />
                                    <Text text="{TableDataModel>TradeMargin}" />
                                    <Text
                                        text="{TableDataModel>DiscountExcl}"
                                    />
                                    <Text
                                        text="{TableDataModel>ExciseDutySt}"
                                    />
                                    <Text
                                        text="{TableDataModel>TaxableValue}"
                                    />
                                    <Text text="{TableDataModel>EdRecovery}" />
                                    <Text text="{TableDataModel>ExciseDuty}" />
                                    <Text
                                        text="{TableDataModel>NetTaxableValue}"
                                    />
                                    <Text text="{TableDataModel>TaxRatePer}" />
                                    <Text text="{TableDataModel>TaxVatRs}" />
                                    <Text text="{TableDataModel>Igst}" />
                                    <Text text="{TableDataModel>IgstPer}" />
                                    <Text text="{TableDataModel>Cgst}" />
                                    <Text text="{TableDataModel>CgstPer}" />
                                    <Text text="{TableDataModel>Sgst}" />
                                    <Text text="{TableDataModel>SgstPer}" />
                                    <Text text="{TableDataModel>Tcs}" />
                                    <Text text="{TableDataModel>TcsPer}" />

                                    <!-- ── Summary / Green columns ───────────────────── -->
                                    <ObjectNumber
                                        number="{TableDataModel>InvoiceValue}"
                                        unit="{TableDataModel>TransactionCurrency}"
                                        emphasized="true"
                                    />
                                    <!-- FIX: was empty <Text text="" />; now bound to Class property -->
                                    <Text text="{TableDataModel>Class}" />
                                    <Text
                                        text="{TableDataModel>SalesOrderDistributionChannel}"
                                    />
                                    <Text
                                        text="{TableDataModel>DailyAuthQty}"
                                    />
                                    <Text
                                        text="{TableDataModel>DailyAuthUnit}"
                                    />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </ScrollContainer>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
